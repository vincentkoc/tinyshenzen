# What this build is: a world (tinynyc, the default, or tinyrao), or "home" for the front page
# that lists the worlds. One build, one target.
NEXT_PUBLIC_WORLD=tinynyc

# Sub-path the site is served under, without a trailing slash.
# Empty for local dev at http://localhost:3000/ ; production uses /tinynyc, /tinyrao, …
NEXT_PUBLIC_BASE_PATH=

# Where the world's data folder is served from, without a trailing slash.
# Default: <base path>/data/<world>, which is public/data/<world>/ locally.
# A production build for /tinyrao sets /tinyrao/data.
# NEXT_PUBLIC_DATA_BASE=

# The site's origin, without a trailing slash. Only needed for share cards (og:image, og:url,
# canonical), which must be absolute URLs. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional page analytics: the URL of a tracker script that takes a data-site-id (Rybbit and
# the like), and this site's id in it. Leave both unset and no tracker is loaded.
# NEXT_PUBLIC_ANALYTICS_SRC=https://analytics.example.com/api/script.js
# NEXT_PUBLIC_ANALYTICS_SITE_ID=

# Optional Google Tag Manager container (GTM-XXXXXXX). What it fires, Google Analytics included,
# is set up in Tag Manager. Leave unset and nothing from Google is loaded.
# NEXT_PUBLIC_GTM_ID=

# Donations (optional). A hosted checkout (a payment link) where the donor sets the amount:
# the default one, in English, and the same in Portuguese and Spanish. A language without its
# own link uses the default. With none set (and no API) nothing about donating is shown.
# NEXT_PUBLIC_DONATE_URL=https://donate.stripe.com/test_example
# NEXT_PUBLIC_DONATE_URL_PT=
# NEXT_PUBLIC_DONATE_URL_ES=

# The GraphQL endpoint of tinyworlds-api (optional): lists the cities being funded and opens a
# checkout for one. A full URL, or a same-origin path in production.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/graphql

# Inside a map: where the front page is ("All cities"). Default "/".
# NEXT_PUBLIC_HOME_URL=/

# On the front page: what the worlds' folders hang from. Default "" (worlds at /tinynyc/, …).
# NEXT_PUBLIC_WORLDS_BASE=

# Development only, for the front page: take the card pictures from one folder (public/og/)
# instead of each world's own (/<id>/og/<id>.jpg), since no world is served beside it.
# NEXT_PUBLIC_CARDS_BASE=/og
