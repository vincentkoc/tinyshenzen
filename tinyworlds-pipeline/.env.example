# Which city to draw when --city is not given: tinysz | tinysz-full
# TINY_CITY=tinysz
# Overture Maps release to read (public S3 bucket, no credentials needed)
OVERTURE_RELEASE=2026-10-21.0
# Where the viewers' data goes; each city gets a folder inside (default: ../tinyworlds-frontend/public/data)
# TINY_OUT=../tinyworlds-frontend/public/data
